{
  "name": "insult-as-a-service",
  "version": "0.1.0",
  "description": "Turn ordinary application error messages into context-aware roasts. Offline, zero runtime dependencies, framework-independent, with a reliable global and per-message opt-out.",
  "keywords": [
    "error",
    "errors",
    "validation",
    "humor",
    "humour",
    "roast",
    "insult",
    "i18n",
    "manglish",
    "typescript"
  ],
  "license": "MIT",
  "author": "ymeer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AmeerFaisalAdanan/insult-as-a-service.git"
  },
  "homepage": "https://github.com/AmeerFaisalAdanan/insult-as-a-service#readme",
  "bugs": {
    "url": "https://github.com/AmeerFaisalAdanan/insult-as-a-service/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema/roast.schema.json",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "packageManager": "npm@10.9.7",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:regression": "vitest run tests/regression",
    "test:security": "vitest run tests/security",
    "test:integration": "vitest run tests/integration",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:roasts": "tsx scripts/validate-roasts.ts",
    "verify:package": "tsx scripts/verify-package.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
